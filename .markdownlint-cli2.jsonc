// Reglas de markdownlint-cli2 para este repo (ver STYLE.md).
// Se relajan las incompatibles con el formato del proyecto:
// - MD013 (longitud de linea): las tablas de recursos son largas por diseno.
// - MD033 (HTML inline): se usan <div>, <details> e <img> a proposito.
// - MD041 (primera linea H1): los README de recurso empiezan con frontmatter.
// - MD026 (puntuacion final en titulos): titulares en espanol con ¿?/¡!.
// - MD060 (estilo de tablas): cosmetico; GitHub las renderiza igual.
// - MD040 (lenguaje en fences): pendiente etiquetar los ~230 bloques
//   existentes (scl/bash/mermaid); hacerlo es una pasada de contenido aparte.
// - MD051 (fragmentos #ancla): apagada a proposito. Para titulos con emoji,
//   markdownlint exige el slug `#-python-vs-c` mientras GitHub resuelve
//   `#python-vs-c`: ningun enlace puede satisfacer a los dos a la vez
//   (comprobado experimentalmente). Los fragmentos reales los cubre lychee
//   semanal, que usa slugs estilo GitHub. Requisito: no usar el selector de
//   variacion U+FE0F en titulares (rompe el ancla tambien en GitHub).
// - MD024 solo entre hermanos: las fichas repiten subsecciones de plantilla
//   (Descripcion/Desafios/Metricas...) bajo cada caso; eso es legitimo.
{
  "config": {
    "default": true,
    "MD013": false,
    "MD026": false,
    "MD033": false,
    "MD041": false,
    "MD060": false,
    "MD040": false,
    "MD051": false,
    "MD024": {
      "siblings_only": true
    }
  },
  "globs": [
    "**/*.md",
    "!node_modules",
    "!_plantillas"
  ]
}
